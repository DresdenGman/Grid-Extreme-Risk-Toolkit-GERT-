# GERT Backend Configuration

# Server
# HOST=0.0.0.0
# PORT=8000
# APP_ENV=development          # development, test, or production

# CORS — comma-separated origins
# Development default: http://localhost:3000
# Production example (no trailing slash):
# ALLOWED_ORIGINS=https://grid-extreme-risk-toolkit-gert.vercel.app,https://gert-d.vercel.app

# Database
# DATABASE_URL=sqlite:///./gert.db
# For PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/gert

# Model Backend
# MODEL_BACKEND=stub           # stub or real
# MODEL_ARTIFACT_DIR=          # required only for MODEL_BACKEND=real

# Official ERCOT Public API (backend only; never prefix these with NEXT_PUBLIC_)
# ERCOT_API_USERNAME=
# ERCOT_API_PASSWORD=
# ERCOT_API_SUBSCRIPTION_KEY=

# Frontend build configuration (Vercel)
# NEXT_PUBLIC_API_URL=https://gert-backend-production.up.railway.app
# NEXT_PUBLIC_DATA_MODE=live   # live is the public default; demo is presentation-only

# AI Analysis (optional)
# API_KEY=your-google-genai-api-key

# Alert Notifications (optional — see docs/REAL_DATA_SETUP.md)
# ALERT_EMAIL_ENABLED=false
# ALERT_SMS_ENABLED=false
# ALERT_WEBHOOK_ENABLED=false
# SMTP_HOST=
# SMTP_PORT=587
# TWILIO_ACCOUNT_SID=
# WEBHOOK_URL=
